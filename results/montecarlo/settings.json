{
  "config": {
    "base_yaml": "in/hierarchy.yaml",
    "config_yaml": "in/config.yaml",
    "profiles_yaml": "in/profiles.yaml",
    "samples_per_profile": 200,
    "out_dir": "results/montecarlo",
    "seed": 42,
    "variability_strength": 1.0,
    "profile_ids": null,
    "cr_threshold": 0.1,
    "cr_mode": "any",
    "dry_run": false,
    "stop_on_error": false
  },
  "schema": {
    "version": 1,
    "aliases": {
      "stages": {
        "KS": "Knowledge selection",
        "KA": "Knowledge analysis",
        "TR": "Model Training",
        "OP": "Model operation"
      },
      "factors": {
        "H": "Human",
        "T": "Technological"
      },
      "risks": {
        "representativeness": "Data representativeness",
        "dataset_bias": "Dataset bias",
        "temporal_bias": "Temporal bias",
        "scale_mismatch": "Scale mismatch",
        "limited_scene_diversity": "Limited scene diversity",
        "annotation_errors": "Annotation errors",
        "inadequate_model_architecture": "Inappropriate model architecture",
        "lack_of_uncertainty_estimation": "Lack of uncertainty estimation",
        "reliance_on_spurious_features": "Reliance on spurious features",
        "incorrect_spatial_geometric_interpretation": "Incorrect spatial-geometric interpretation",
        "domain_shift": "Domain shift",
        "incomplete_validation_criteria": "Incomplete validation criteria",
        "overfitting": "Overfitting",
        "confabulations": "Confabulations",
        "confidence_miscalibration": "Confidence miscalibration",
        "catastrophic_forgetting": "Catastrophic forgetting",
        "loss_of_situational_awareness": "Loss of situational awareness",
        "sensor_artifacts": "Sensor artifacts",
        "concept_drift": "Concept drift",
        "cascading_error_propagation": "Cascading error propagation"
      }
    },
    "scale": {
      "relations": {
        "=": 0,
        ">": 2,
        ">>": 4
      },
      "priorities": {
        "low": 1,
        "medium": 2,
        "high": 3,
        "very_high": 4
      }
    }
  },
  "profiles": {
    "P1": {
      "name": "AI/ML-heavy",
      "description": "Focus on uncertainty, calibration, confabulations, and model-related risks.",
      "stage_expression": "KA = TR > OP > KS",
      "parsed_factor_rules": {
        "KS": "H > T",
        "KA": "T > H",
        "TR": "T > H",
        "OP": "T > H"
      },
      "parsed_risk_profile": {
        "KS": {
          "H": {
            "representativeness": 3,
            "dataset_bias": 3,
            "temporal_bias": 2,
            "scale_mismatch": 2,
            "limited_scene_diversity": 2
          }
        },
        "KA": {
          "H": {
            "annotation_errors": 2,
            "inadequate_model_architecture": 3,
            "lack_of_uncertainty_estimation": 3
          },
          "T": {
            "reliance_on_spurious_features": 2,
            "incorrect_spatial_geometric_interpretation": 3
          }
        },
        "TR": {
          "H": {
            "domain_shift": 3,
            "incomplete_validation_criteria": 3
          },
          "T": {
            "overfitting": 2,
            "confabulations": 4,
            "confidence_miscalibration": 4,
            "catastrophic_forgetting": 1
          }
        },
        "OP": {
          "H": {
            "loss_of_situational_awareness": 2
          },
          "T": {
            "sensor_artifacts": 2,
            "concept_drift": 2,
            "cascading_error_propagation": 3
          }
        }
      }
    },
    "P2": {
      "name": "Swarm/Ops-heavy",
      "description": "Focus on operation-stage risks, coordination failures, and cascading effects in the swarm.",
      "stage_expression": "OP >> TR > KA > KS",
      "parsed_factor_rules": {
        "KS": "H > T",
        "KA": "T > H",
        "TR": "T > H",
        "OP": "T >> H"
      },
      "parsed_risk_profile": {
        "KS": {
          "H": {
            "representativeness": 2,
            "dataset_bias": 2,
            "temporal_bias": 1,
            "scale_mismatch": 1,
            "limited_scene_diversity": 1
          }
        },
        "KA": {
          "H": {
            "annotation_errors": 1,
            "inadequate_model_architecture": 2,
            "lack_of_uncertainty_estimation": 2
          },
          "T": {
            "reliance_on_spurious_features": 1,
            "incorrect_spatial_geometric_interpretation": 2
          }
        },
        "TR": {
          "H": {
            "domain_shift": 2,
            "incomplete_validation_criteria": 2
          },
          "T": {
            "overfitting": 2,
            "confabulations": 2,
            "confidence_miscalibration": 2,
            "catastrophic_forgetting": 1
          }
        },
        "OP": {
          "H": {
            "loss_of_situational_awareness": 3
          },
          "T": {
            "sensor_artifacts": 3,
            "concept_drift": 3,
            "cascading_error_propagation": 4
          }
        }
      }
    },
    "P3": {
      "name": "Balanced",
      "description": "Balanced profile with moderate priorities across the lifecycle and risk groups.",
      "stage_expression": "OP > TR = KA > KS",
      "parsed_factor_rules": {
        "KS": "H = T",
        "KA": "T = H",
        "TR": "T = H",
        "OP": "T > H"
      },
      "parsed_risk_profile": {
        "KS": {
          "H": {
            "representativeness": 2,
            "dataset_bias": 2,
            "temporal_bias": 2,
            "scale_mismatch": 2,
            "limited_scene_diversity": 2
          }
        },
        "KA": {
          "H": {
            "annotation_errors": 2,
            "inadequate_model_architecture": 2,
            "lack_of_uncertainty_estimation": 2
          },
          "T": {
            "reliance_on_spurious_features": 2,
            "incorrect_spatial_geometric_interpretation": 2
          }
        },
        "TR": {
          "H": {
            "domain_shift": 2,
            "incomplete_validation_criteria": 2
          },
          "T": {
            "overfitting": 2,
            "confabulations": 2,
            "confidence_miscalibration": 2,
            "catastrophic_forgetting": 1
          }
        },
        "OP": {
          "H": {
            "loss_of_situational_awareness": 2
          },
          "T": {
            "sensor_artifacts": 2,
            "concept_drift": 2,
            "cascading_error_propagation": 3
          }
        }
      }
    },
    "P4": {
      "name": "Safety/Validation-heavy",
      "description": "Focus on uncertainty handling, validation quality, safety constraints, and fallback behavior.",
      "stage_expression": "OP = TR = KA > KS",
      "parsed_factor_rules": {
        "KS": "H = T",
        "KA": "T > H",
        "TR": "T > H",
        "OP": "T = H"
      },
      "parsed_risk_profile": {
        "KS": {
          "H": {
            "representativeness": 2,
            "dataset_bias": 2,
            "temporal_bias": 2,
            "scale_mismatch": 1,
            "limited_scene_diversity": 1
          }
        },
        "KA": {
          "H": {
            "annotation_errors": 2,
            "inadequate_model_architecture": 2,
            "lack_of_uncertainty_estimation": 4
          },
          "T": {
            "reliance_on_spurious_features": 1,
            "incorrect_spatial_geometric_interpretation": 3
          }
        },
        "TR": {
          "H": {
            "domain_shift": 2,
            "incomplete_validation_criteria": 4
          },
          "T": {
            "overfitting": 1,
            "confabulations": 3,
            "confidence_miscalibration": 4,
            "catastrophic_forgetting": 1
          }
        },
        "OP": {
          "H": {
            "loss_of_situational_awareness": 3
          },
          "T": {
            "sensor_artifacts": 2,
            "concept_drift": 2,
            "cascading_error_propagation": 3
          }
        }
      }
    }
  }
}